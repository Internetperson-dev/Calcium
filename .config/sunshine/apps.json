            "prep-cmd": [
                {
                    "do": "",
                    "undo": "setsid flatpak run com.valvesoftware.Steam steam steam://open/bigpicture steam://close/bigpicture"
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "setsid flatpak run com.valvesoftware.Steam steam steam://open/bigpicture",
