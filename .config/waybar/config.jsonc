{
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "custom/steam",
    "pulseaudio",
    "custom/notifications",
    "clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": false,
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "",
    "scroll-step": 5
  },

  "tray": {
    "spacing": 8
  },

  "custom/launcher": {
    "format": "",
    "tooltip": "Launcher",
    "on-click": "wofi --show drun"
  },

  "custom/steam": {
    "format": "",
    "tooltip": "Steam",
    "on-click": "steam"
  },

  "custom/notifications": {
    "format": "",
    "tooltip": "Notifications",
    "on-click": "swaync-client -t"
  }
}
