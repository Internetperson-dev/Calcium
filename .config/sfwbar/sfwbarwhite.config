# Override gtk theme
# theme = "Adwaita-dark"
# Override gtk icon theme
# IconTheme = "Adwaita"

Set Term = "foot"

# Window Placer
placer {
  xorigin = 5  # place the first window at X% from the left
  yorigin = 5  # place the first window at X% from the top
  xstep = 5    # step by X% of desktop horizontally
  ystep = 5    # step by X% of desktop vertically
  children = true
}

# Task Switcher
switcher {
  interval = 700
  icons = true
  labels = false
  cols = 5
}

function("SfwbarInit") {
#  Config "PopUp 'XVolumeWindow' { AutoClose = true }"
}

include("winops.widget")
include("cal.widget")

# Panel layout

layout "sfwbar" {

  layer = "top"
  exclusive_zone = "-1"
  bar_id = "bar-0"
  mirror = "*"
#  sensor = 300
#  monitor = "eDP-1"

  include("startmenu.widget")
  include("showdesktop.widget")

  taskbar {
    rows = 1
    group = true
    group cols = 1
    group style = "taskbar_group"
    group labels = false     # Hide labels for clean dock look
    group icons = true
    icons = true
    labels = false
    action[RightClick] = Menu "winops"
    css = "* { justify-content: center; }"  # center icons horizontally
    icon-size = 16                         # smaller icons
  }

  label { css = "* { -GtkWidget-hexpand: true; min-height: 28px; }" }

  tray {
    rows = 1
    css = "* { justify-content: center; }"  # center tray icons
  }

  include("battery-svg.widget")
  include("bluez.widget")
  include("network-module.widget")
  include("volume.widget")
  include("mpd-intmod.widget")
  include("ncenter.widget")
  include("sway-lang.widget")

  grid {
    css = "* { -GtkWidget-direction: bottom; padding: 5px; padding-left: 0px; }"
    action[0] = Function "XCalInit"
    action = Function "XCalPopUp"
    label {
      value = Time("%k:%M")
      style ="clock"
      id = "clock_label"
    }
    label {
      value = Time("%Y-%m-%d")
      style ="clock"
    }
  }
}

#CSS Styling

@define-color theme_bg_color rgba(35, 35, 35, 0.85);  /* dark translucent */
@define-color theme_fg_color #d1d1d1;
@define-color theme_text_color #d1d1d1;
@define-color borders #777777;

window {
  -GtkWidget-direction: bottom;
  background-color: @theme_bg_color;   /* dark translucent background */
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.6); /* subtle shadow */
  border-radius: 8px;
}

label {
  font: 12px sans;
  color: @theme_text_color;
  text-shadow: none;
}

/* Dock/taskbar buttons */
button#taskbar_item {
  background-color: transparent;
  border: 0;
  box-shadow: none;
  min-height: 24px;
  min-width: 24px;
  padding: 0;
  margin: 0 4px;
}

button#taskbar_item image {
  min-width: 16px;
  min-height: 16px;
  margin-left: auto;
  margin-right: auto;
  display: block;
}

/* Center dock icons horizontally */
taskbar > * {
  justify-content: center;
}

/* Tray icons */
button#tray_item {
  background: transparent;
  border: 0;
  padding: 0;
  margin: 0 2px;
}

button#tray_item image {
  min-width: 16px;
  min-height: 16px;
  margin-left: auto;
  margin-right: auto;
  display: block;
}

/* Clock top-left position */
label#clock_label {
  position: fixed;
  top: 5px;
  left: 5px;
  font-size: 14px;
  font-weight: bold;
  background: transparent;
  color: @theme_text_color;
  z-index: 9999;
  padding: 2px 6px;
  border-radius: 4px;
  -GtkWidget-hexpand: false;
  -GtkWidget-halign: start;
  -GtkWidget-valign: start;
}

/* Hide the default date label so only clock is shown */
layout "sfwbar" > grid > label:nth-child(2) {
  display: none;
}
